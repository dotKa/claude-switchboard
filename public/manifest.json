{
  "manifest_version": 3,
  "name": "Switchboard for Claude",
  "short_name": "Switchboard",
  "version": "0.1.0",
  "description": "Unofficial: switch between Claude.ai and Claude Platform accounts, track usage limits and API spend, and auto-switch with rules.",
  "minimum_chrome_version": "120",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "Switchboard for Claude",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_page": "options/index.html",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "cookies",
    "storage",
    "alarms",
    "notifications",
    "tabs",
    "declarativeNetRequest",
    "browsingData"
  ],
  "host_permissions": [
    "https://claude.ai/*"
  ],
  "commands": {
    "switch-next": {
      "suggested_key": {
        "default": "Alt+Shift+N"
      },
      "description": "Switch to the next Claude account"
    }
  },
  "optional_host_permissions": [
    "https://platform.claude.com/*"
  ]
}
